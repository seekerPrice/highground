# Dockerfile-specific root-context allowlist. No .env, credentials or local evidence.
**
!api/
!api/**/
!api/**/*.py
!api/i18n/*.json
!api/requirements.txt
api/tests/
api/fixtures/
api/**/__pycache__/
!api/requirements-build.txt
!api/fonts/
!api/fonts/*.ttf
!api/fonts/*-OFL.txt
!api/fonts/manifest.json
