# Task 1 runs without this file. Later tasks will wire these settings.
# Keep secrets and project-specific values in an ignored .env or Secret Manager.
GCP_PROJECT=
GCP_REGION=asia-southeast1
VERTEX_LOCATION=
GEMINI_FAST_MODEL=
GEMINI_PRO_MODEL=
GCS_BUCKET=
PUBSUB_TOPIC=flood-events
BQ_DATASET=highground
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEMO_MODE=false
DEFAULT_ALERT_RADIUS_M=1000
NEIGHBOUR_RADIUS_M=500
CHECK_RADIUS_M=2000
GOOGLE_MAPS_API_KEY=
HASH_SALT=
LORRY_CAPACITY_M3=10
OUTCOME_ASK_AFTER_H=6

# Onboarding: username is public; geocoding stays unavailable without an identifiable UA.
TELEGRAM_BOT_USERNAME=
GEOCODING_USER_AGENT=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
VEHICLE_ACTION_TARGET_MINUTES=15
STOCK_ACTION_TARGET_MINUTES=30

# Registry lookup cutoff only; no assertion about route/site availability or safety.
DESTINATION_SEARCH_RADIUS_M=20000

# Hosted Scheduler authorization: exact service account email AND numeric subject.
SCHEDULER_AUDIENCE=
SCHEDULER_CALLER_EMAIL=
SCHEDULER_CALLER_SUBJECT=
# Both false by default; local operator auth additionally requires demo mode + loopback emulator.
LOCAL_DEVELOPMENT=false
SCHEDULER_LOCAL_AUTH=false
